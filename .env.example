# Copy this file to .env.local and fill in real values for local development.
# Production/Preview values live in Vercel: Project Settings -> Environment Variables
# (or `vercel env add <NAME>` / `vercel env pull`).

# ---------------------------------------------------------------------------
# Analytics (app/layout.tsx)
# ---------------------------------------------------------------------------

# Google Analytics 4 Measurement ID, rendered by <GoogleAnalytics> from
# @next/third-parties/google. Find it at:
#   Google Analytics -> Admin -> Data Streams -> (your web stream) -> Measurement ID
# Format looks like G-XXXXXXXXXX. Must be prefixed NEXT_PUBLIC_ because it is
# read in the browser. If left empty the analytics tag is simply not rendered,
# so local dev and previews stay out of your reporting unless you set it.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Canonical origin, used for metadataBase, sitemap, robots and OG image URLs.
# No trailing slash, e.g. https://dentlab.nz
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Quote / contact form (app/api/contact/route.ts) sends enquiries via Gmail SMTP
# ---------------------------------------------------------------------------

# The Gmail address that sends AND receives enquiry emails.
GMAIL_EMAIL=

# A Gmail App Password (NOT the account password). Requires 2-Step
# Verification on the account, then:
#   Google Account -> Security -> 2-Step Verification -> App passwords
#   https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Instagram gallery (lib/instagram.ts, app/api/instagram-refresh/route.ts)
# ---------------------------------------------------------------------------

# Long-lived Instagram access token (Instagram API with Instagram Login,
# graph.instagram.com). Read only as a fallback at cold start when Redis has
# no token yet; the monthly cron keeps the live token fresh in Redis.
INSTAGRAM_GRAPH_API_KEY=

# Shared secret the monthly cron (vercel.json -> /api/instagram-refresh) must
# present as `Authorization: Bearer <CRON_SECRET>`. Vercel attaches this header
# to its own Cron Job invocations if the var exists on the project. Generate a
# random value, e.g. `openssl rand -hex 32`, and set it in Production.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Upstash Redis (holds the rotating Instagram token)
# ---------------------------------------------------------------------------
# Auto-populated when the "Upstash for Redis" integration is added from the
# Vercel Marketplace/Storage tab do not set these by hand. Pull them with
# `vercel env pull`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
